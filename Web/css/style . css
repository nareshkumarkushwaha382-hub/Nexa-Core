*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{

    background:#0D0D0D;

    display:flex;

    justify-content:center;

    align-items:center;

    height:100vh;

    overflow:hidden;

    font-family:Arial,sans-serif;

}

#logo{

    width:180px;

    opacity:0;

    animation:fade 2s forwards;

}

@keyframes fade{

    from{

        opacity:0;
        transform:scale(.9);

    }

    to{

        opacity:1;
        transform:scale(1);

    }

}
